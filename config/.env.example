# Vorlage für config/.env – kopieren nach config/.env und anpassen.
# config/.env kommt NICHT ins Git (steht in der .gitignore) und ist per Web gesperrt (config/.htaccess).

# Daten-Datenbank – daraus baut config/gateway.php den DSN (fehlt ein Wert, gilt der Standard)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fahrzeugverwaltung
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASS=

# Login-Datenbank (nur nötig, wenn sicherheit.aktiv in config/gateway.php auf true steht).
# Leer lassen = die Login-Tabelle liegt in der Daten-Datenbank oben.
# Ist LOGIN_DB_NAME gesetzt, werden ALLE LOGIN_DB_*-Werte genommen (nicht gemischt).
LOGIN_DB_HOST=
LOGIN_DB_PORT=
LOGIN_DB_NAME=
LOGIN_DB_CHARSET=
LOGIN_DB_USER=
LOGIN_DB_PASS=

# Geheimnis zum Signieren der Tokens (Pflicht bei aktiver Anmeldung, mindestens 32 Zeichen).
# Erzeugen:  php -r "echo bin2hex(random_bytes(32));"
# Ändern macht alle ausgegebenen Tokens ungültig.
TOKEN_SECRET=

# 1 = genaue Fehlermeldungen in der Antwort (nur zum Entwickeln), 0 = aus
API_DEBUG=0
