# Optional: URLs ohne "api.php"
#   http://localhost/MyEndPoint/api/fahrzeuge/5  →  wird von api.php beantwortet
#   http://localhost/MyEndPoint/fahrzeuge/5      →  ebenso
# Braucht mod_rewrite (bei XAMPP aktiv). Ohne diese Datei funktioniert
#   http://localhost/MyEndPoint/api.php/fahrzeuge/5
# ganz normal weiter. Vorhandene Dateien (z. B. formular.html) bleiben erreichbar.

RewriteEngine On

# Header "Authorization" (Token der Anmeldung) an PHP weitergeben – nötig, falls PHP als FastCGI läuft
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Interne Ordner und versteckte Pfade (.git, .idea, .env …) nie über das Web ausliefern → 403
RewriteRule ^(config|cache|vendor|src|bin)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ api.php [QSA,L]
